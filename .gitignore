# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
build/
dist/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Dados (grandes / gerados — nunca versionar os brutos ou intermediários) ---
data/raw/*
!data/raw/.gitkeep
!data/raw/SOURCE.txt
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/canonical_dataset_registry.json
!data/processed/NON_CANONICAL.md
!data/processed/split_manifest_v1.json
!data/processed/train_runs.csv
!data/processed/validation_runs.csv
!data/processed/test_runs.csv
!data/processed/preprocessing_registry.json
!data/processed/preprocessor_v1_scaler_params.json

# --- Modelos treinados (binários grandes) ---
models/*
!models/.gitkeep

# --- Resultados gerados ---
results/raw/*
!results/raw/.gitkeep
results/predictions/*
!results/predictions/.gitkeep
# Predições do experimento oficial v1.0 (permitem `make reproduce` sem retreino)
!results/predictions/exp-a4-v2__*
results/dry_run/*
!results/dry_run/.gitkeep
!results/dry_run/DRY_RUN_README.md

# Métricas, tabelas, figuras e metadados costumam ser pequenos e valem a
# pena versionar para auditoria (docs/protocols/reproducibility_protocol.md).
# results/metrics/*
# results/tables/*
# results/figures/*
# results/metadata/*

# --- Notebooks: remova outputs pesados antes de commitar quando possível ---

# --- LaTeX (artefatos de compilação; versionar .tex/.bib/.pdf) ---
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Segredos (nunca commitar — AGENTS.md GIT-R04) ---
.env
*.pem
*.key
secrets.yaml
